# Existing application settings (replace placeholders locally).
DATABASE_URL=postgresql://user:password@localhost:5432/medical_reports
SECRET_KEY=replace-with-an-application-signing-secret
GEMINI_API_KEY=replace-with-your-gemini-key

# Google sign-in is unavailable until this project is configured.
FIREBASE_PROJECT_ID=
# Optional absolute path OUTSIDE the repository. If absent, Admin uses ADC.
FIREBASE_SERVICE_ACCOUNT_PATH=
# For ADC, GOOGLE_APPLICATION_CREDENTIALS must be a process environment
# variable, or supplied by the hosting platform's workload identity.
